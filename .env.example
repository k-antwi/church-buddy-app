# Only variables prefixed with VITE_ are exposed to client-side code
VITE_APP_TITLE=ChurchPanel
VITE_API_BASE_URL=https://churchpanel.ddev.site
# Base domain appended when a user enters a short workspace slug (e.g. "christrends").
# Production: churchpanel.org  |  Local ddev: churchpanel.ddev.site
VITE_TENANT_BASE_DOMAIN=churchpanel.org
